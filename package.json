{
  "name": "@persianstudio/tourara",
  "version": "0.1.0",
  "description": "React product tour & onboarding library — SVG spotlight mask, smart tooltips, tip markers, RTL/LTR, custom UI slots. MIT. React-only peers (no MUI).",
  "license": "MIT",
  "author": "Persian Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PersianStudio/tourara.git"
  },
  "homepage": "https://persianstudio.github.io/tourara/",
  "bugs": {
    "url": "https://github.com/PersianStudio/tourara/issues"
  },
  "keywords": [
    "react",
    "react-tour",
    "product-tour",
    "onboarding",
    "user-onboarding",
    "walkthrough",
    "guided-tour",
    "feature-tour",
    "spotlight",
    "spotlight-tour",
    "mask",
    "tooltip",
    "tip-markers",
    "rtl",
    "ltr",
    "i18n",
    "intro.js",
    "shepherd",
    "reactour",
    "driver.js",
    "joyride",
    "typescript",
    "persian-studio",
    "tourara"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/tourara.css",
    "LICENSE",
    "README.md",
    "README.fa.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/tourara.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config vite.showcase.config.ts",
    "clean": "rm -rf dist showcase-dist",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "build": "pnpm clean && vite build && cp src/styles/tourara.css dist/tourara.css",
    "build:showcase": "vite build --config vite.showcase.config.ts",
    "preview": "vite preview --config vite.showcase.config.ts",
    "prepack": "pnpm typecheck && pnpm build",
    "pack:check": "node scripts/assert-npm-pack.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm pack:check"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^5.15.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3"
  },
  "packageManager": "pnpm@9.15.0"
}
