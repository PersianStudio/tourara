{
  "name": "@persianstudio/tourara",
  "version": "0.1.0",
  "description": "Product tour toolkit for React — mask, tooltip, tips, and smart positioning. Zero UI-library peers.",
  "license": "MIT",
  "author": "Persian Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PersianStudio/tourara.git"
  },
  "homepage": "https://persianstudio.github.io/tourara/",
  "bugs": {
    "url": "https://github.com/PersianStudio/tourara/issues"
  },
  "keywords": [
    "react",
    "tour",
    "onboarding",
    "walkthrough",
    "tooltip",
    "product-tour",
    "spotlight",
    "rtl"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.fa.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/tourara.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config vite.showcase.config.ts",
    "clean": "rm -rf dist showcase-dist",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "build": "pnpm clean && vite build && cp src/styles/tourara.css dist/tourara.css",
    "build:showcase": "vite build --config vite.showcase.config.ts",
    "preview": "vite preview --config vite.showcase.config.ts",
    "prepack": "pnpm typecheck && pnpm build",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^5.15.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3"
  },
  "packageManager": "pnpm@9.15.0"
}
